# Public, non-secret configuration
DEMO_MODE=true
SITE_URL=https://cfbapex.com

# Protected operations
ADMIN_EMAILS=

# Durable infrastructure (leave unset for fixture preview)
DATABASE_URL=
CACHE_URL=

# Server-side provider credentials and rights-gated adapters
SPORTS_DATA_API_KEY=
ODDS_API_KEY=
WEATHER_API_KEY=
EMAIL_API_KEY=
ANALYTICS_WRITE_KEY=
ERROR_TRACKING_DSN=
CONSENT_MANAGER_ID=
AD_PROVIDER_ID=
AFFILIATE_REGISTRY_SECRET=
TICKETING_API_KEY=
STREAMING_PROVIDER_KEY=
MAPS_API_KEY=
IMAGE_LICENSE_PROVIDER_KEY=
ADMIN_AUTH_SECRET=

# Public live launch evidence gates (deny-by-default; approvals are never inferred)
CORE_DATA_RIGHTS_APPROVED=false
POLL_RIGHTS_APPROVED=false
MARKS_POLICY_APPROVED=false
PROVIDER_CREDENTIALS_CONFIGURED=false
ENTITY_CROSSWALK_VERIFIED=false
SHADOW_PILOT_PASSED=false
INGESTION_RECOVERY_DRILL_PASSED=false
KILL_SWITCH_DRILL_PASSED=false
ON_CALL_OWNER_ASSIGNED=false
LEGAL_LAUNCH_APPROVED=false
PUBLIC_LAUNCH_APPROVED=false

# Global kill switches
DISABLE_LIVE_PROVIDERS=true
DISABLE_OFFICIAL_POLLS=true
DISABLE_ODDS=true
DISABLE_ADS=true
DISABLE_AFFILIATES=true
DISABLE_EMAIL_SEND=true
